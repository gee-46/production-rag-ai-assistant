# Copy to .env and fill in secrets. Never commit the real .env file.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

SECRET_KEY=change-me-to-a-long-random-string
AUTH_ENABLED=false  # Set to true to enforce JWT login & RBAC; false for login-free local demo


DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ragdb

# sentence_transformers | openai | fake
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# groq | openai | anthropic | ollama | fake
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

CHUNK_TARGET_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RERANK_TOP_K=5

MAX_UPLOAD_MB=25
UPLOAD_DIR=./data/uploads
